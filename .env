# Environment configuration for ActionLoop
APP_NAME=ActionLoop
APP_ENV=development
DEBUG=true
PORT=8000

# Mode toggle: Set to true for 100% zero-API-key local execution with fixture / deterministic NLP fallback
DEMO_MODE=true

# AI / LLM Configuration
# When DEMO_MODE=false, provide your Gemini API key:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Database
DATABASE_URL=sqlite:///./actionloop.db

# Tracker Integration (mock | github | linear | trello)
TRACKER_INTEGRATION=mock
GITHUB_TOKEN=
GITHUB_REPO=
LINEAR_API_KEY=

# Notification Configuration (console | in_app | webhook)
NOTIFIER_INTEGRATION=console
SLACK_WEBHOOK_URL=

# Confirmation & Safety Enforcement
DRY_RUN=false
STRICT_CONFIRMATION=true
